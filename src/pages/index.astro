<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#1b4332" />
    <title>CFP Distribution — Assistant commercial</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <!-- Header -->
    <header class="header">
      <div class="header-inner">
        <div class="avatar">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="#2d6a4f"/>
            <path d="M12 28 C12 22 28 22 28 28" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <circle cx="20" cy="16" r="5" fill="white"/>
          </svg>
        </div>
        <div class="header-info">
          <span class="header-name">Assistant CFP Distribution</span>
          <span class="header-status">
            <span class="status-dot"></span>En ligne
          </span>
        </div>
      </div>
    </header>

    <!-- Zone messages -->
    <main class="chat-area" id="chatArea">
      <div class="messages" id="messages">
        <!-- Message de bienvenue -->
        <div class="message bot" id="welcomeMsg">
          <div class="bubble">
            Bonjour ! Je suis l'assistant commercial CFP Distribution.<br/>
            Je peux vous donner un prix pour vos clôtures aluminium, kits occultants ou couvertines.<br/><br/>
            <strong>Comment puis-je vous aider ?</strong>
          </div>
          <span class="time" id="welcomeTime"></span>
        </div>
      </div>
    </main>

    <!-- Zone saisie -->
    <footer class="input-area">
      <form class="input-form" id="inputForm">
        <input
          type="text"
          id="userInput"
          class="input-field"
          placeholder="Votre message..."
          autocomplete="off"
          autocorrect="off"
          enterkeyhint="send"
          maxlength="500"
        />
        <button type="submit" class="send-btn" id="sendBtn" aria-label="Envoyer">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22 2L11 13" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>
    </footer>

  </body>
</html>

<script>
  const API_URL = "https://back.poktools.com/api/agent/chat";

  const messagesEl  = document.getElementById("messages");
  const inputForm   = document.getElementById("inputForm");
  const userInput   = document.getElementById("userInput");
  const sendBtn     = document.getElementById("sendBtn");
  const chatArea    = document.getElementById("chatArea");

  // sessionId persistant dans localStorage
  let sessionId = localStorage.getItem("cfp_session") || null;

  // Heure de bienvenue
  document.getElementById("welcomeTime").textContent = formatTime(new Date());

  function formatTime(date) {
    return date.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
  }

  function scrollToBottom() {
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function addMessage(text, role) {
    const div   = document.createElement("div");
    div.className = `message ${role}`;

    const bubble = document.createElement("div");
    bubble.className = "bubble";
    bubble.textContent = text;

    const time   = document.createElement("span");
    time.className = "time";
    time.textContent = formatTime(new Date());

    div.appendChild(bubble);
    div.appendChild(time);
    messagesEl.appendChild(div);
    scrollToBottom();
    return div;
  }

  function showTyping() {
    const div    = document.createElement("div");
    div.className = "message bot typing-wrapper";
    div.id        = "typing";
    div.innerHTML = `
      <div class="bubble typing">
        <span></span><span></span><span></span>
      </div>
    `;
    messagesEl.appendChild(div);
    scrollToBottom();
  }

  function removeTyping() {
    document.getElementById("typing")?.remove();
  }

  function setLoading(on) {
    sendBtn.disabled   = on;
    userInput.disabled = on;
    sendBtn.classList.toggle("loading", on);
  }

  inputForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = userInput.value.trim();
    if (!text) return;

    addMessage(text, "user");
    userInput.value = "";
    setLoading(true);
    showTyping();

    try {
      const res = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sessionId, message: text }),
      });

      const data = await res.json();
      removeTyping();

      if (data.sessionId) {
        sessionId = data.sessionId;
        localStorage.setItem("cfp_session", sessionId);
      }

      addMessage(data.reply || "Désolé, je n'ai pas pu répondre.", "bot");
    } catch {
      removeTyping();
      addMessage("Une erreur est survenue. Vérifiez votre connexion.", "bot error");
    } finally {
      setLoading(false);
      userInput.focus();
    }
  });

  // Auto-focus sur desktop
  if (window.innerWidth > 768) userInput.focus();

  // Resize : garder le scroll en bas quand le clavier mobile s'ouvre
  window.addEventListener("resize", () => scrollToBottom());
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --green-dark:   #1b4332;
    --green:        #2d6a4f;
    --green-light:  #8dc63f;
    --bubble-bot:   #f0f4f0;
    --bubble-user:  #2d6a4f;
    --text-main:    #1a1a1a;
    --text-muted:   #888;
    --bg:           #f0f2f0;
    --header-h:     64px;
    --footer-h:     72px;
    --radius:       18px;
    --font:         'Inter', system-ui, sans-serif;
  }

  html, body {
    height: 100%;
    overflow: hidden;
    font-family: var(--font);
    background: var(--bg);
    color: var(--text-main);
    -webkit-font-smoothing: antialiased;
  }

  /* ── Header ── */
  .header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--header-h);
    background: var(--green-dark);
    z-index: 10;
    box-shadow: 0 2px 12px rgba(0,0,0,.25);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    padding: 0 16px;
    max-width: 680px;
    margin: 0 auto;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .avatar svg { width: 100%; height: 100%; }

  .header-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .header-name {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }

  .header-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #a8d5b5;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8dc63f;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: .4; }
  }

  /* ── Zone messages ── */
  .chat-area {
    position: fixed;
    top: var(--header-h);
    bottom: var(--footer-h);
    left: 0; right: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding: 16px 12px;
    scroll-behavior: smooth;
  }

  .messages {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── Bulles ── */
  .message {
    display: flex;
    flex-direction: column;
    max-width: 82%;
    animation: fadeUp .2s ease;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .message.user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .message.bot {
    align-self: flex-start;
    align-items: flex-start;
  }

  .bubble {
    padding: 10px 14px;
    border-radius: var(--radius);
    font-size: 15px;
    line-height: 1.5;
    word-break: break-word;
  }

  .message.user .bubble {
    background: var(--bubble-user);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .message.bot .bubble {
    background: var(--bubble-bot);
    color: var(--text-main);
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06);
  }

  .message.error .bubble {
    background: #fdecea;
    color: #c0392b;
  }

  .time {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 3px;
    padding: 0 4px;
  }

  /* ── Typing indicator ── */
  .bubble.typing {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 12px 16px;
    min-width: 52px;
  }

  .bubble.typing span {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #aaa;
    animation: bounce 1.2s infinite;
  }

  .bubble.typing span:nth-child(2) { animation-delay: .2s; }
  .bubble.typing span:nth-child(3) { animation-delay: .4s; }

  @keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); }
    40%           { transform: translateY(-6px); }
  }

  /* ── Input ── */
  .input-area {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    height: var(--footer-h);
    background: #fff;
    border-top: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    padding: 0 12px;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .input-form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  .input-field {
    flex: 1;
    height: 46px;
    border: 1.5px solid #ddd;
    border-radius: 24px;
    padding: 0 18px;
    font-size: 16px; /* 16px évite le zoom iOS */
    font-family: var(--font);
    color: var(--text-main);
    background: #f8f8f8;
    outline: none;
    transition: border-color .2s, background .2s;
  }

  .input-field:focus {
    border-color: var(--green);
    background: #fff;
  }

  .input-field:disabled {
    opacity: .6;
    cursor: not-allowed;
  }

  .send-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--green);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background .2s, transform .1s;
  }

  .send-btn:hover:not(:disabled) { background: var(--green-dark); }
  .send-btn:active:not(:disabled) { transform: scale(.93); }
  .send-btn:disabled { opacity: .5; cursor: not-allowed; }

  .send-btn svg {
    width: 20px;
    height: 20px;
  }

  .send-btn.loading {
    animation: spin .8s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Responsive desktop ── */
  @media (min-width: 680px) {
    .chat-area  { padding: 24px 20px; }
    .input-area { padding: 0 20px; }
    .bubble     { font-size: 15px; }
  }
</style>
